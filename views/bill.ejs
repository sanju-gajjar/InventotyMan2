            left: 0;
            right: 0;
            max-height: 250px;
            overflow-y: auto;
            background: white;
            box-shadow: 0 8px 24px rgba(0,0,0,0.18);
        }
        .autocomplete-items div {
            padding: 12px;
            cursor: pointer;
            border-bottom: 1px solid #e2e8f0;
            font-size: 15px;
        }
        .autocomplete-items div:hover {
            background-color: #e9ecef;
        }
        .autocomplete-active {
            background-color: #6366f1 !important;
            color: white;
        }
        td {
            position: relative;
        }
    </style>
