<!doctype html>
<html lang="en">

<head>
  <!-- Required meta tags -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!--Custom CSS-->
  <link rel="stylesheet" href="styles.css">
  <!--Semantic-UI CSS-->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.2.13/semantic.min.css">
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-BmbxuPwQa2lc/FVzBcNJ7UAyJxM6wuqIj61tLrc4wSX0szH/Ev+nYRRuWlolflfl" crossorigin="anonymous">
  <script src="easyInvoice.min.js"></script>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <title>Invoice Generation - Billing</title>
</head>

<body>
  <style>
    :root {
      --primary-color: #2563eb;
      --primary-hover: #1d4ed8;
      --success-color: #10b981;
      --danger-color: #ef4444;
      --warning-color: #f59e0b;
      --text-primary: #1f2937;
      --text-secondary: #6b7280;
      --border-color: #e5e7eb;
      --bg-light: #f9fafb;
      --bg-white: #ffffff;
      --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
      --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
      --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: var(--text-primary);
      line-height: 1.6;
    }

    .material-icons {
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .material-icons:hover {
      transform: scale(1.1);
    }

    /* Invoice Container Styles */
    .invoice-container {
      max-width: 100%;
      margin: 0;
      background: transparent;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
    }

    .invoice-header-section {
      background: linear-gradient(135deg, var(--primary-color) 0%, #1e40af 100%);
      color: white;
      padding: 25px 35px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-lg);
    }

    .invoice-title {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .invoice-subtitle {
      font-size: 13px;
      opacity: 0.9;
      font-weight: 400;
    }

    /* Customer Information Section */
    .customer-info-section {
      padding: 25px 35px;
      background: var(--bg-white);
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-md);
    }

    .section-title {
      font-size: 15px;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title .material-icons {
      font-size: 20px;
      color: var(--primary-color);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-label {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .form-input {
      padding: 10px 14px;
      border: 2px solid var(--border-color);
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.3s ease;
      background: var(--bg-white);
      color: var(--text-primary);
    }

    .form-input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      background: var(--bg-white);
    }

    .form-input::placeholder {
      color: #9ca3af;
      font-weight: 400;
    }

    /* Invoice Items Section */
    .invoice-items-section {
      padding: 25px 35px;
      background: var(--bg-white);
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-md);
    }

    .table-wrapper {
      overflow-x: auto;
      margin-top: 18px;
      border-radius: 12px;
      border: 2px solid var(--border-color);
    }

    .invoice-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      background: var(--bg-white);
      min-width: 1200px;
    }

    .invoice-table thead {
      background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
    }

    .invoice-table th {
      padding: 14px 10px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-primary);
      text-align: center;
      border-bottom: 2px solid var(--border-color);
      white-space: nowrap;
    }

    .invoice-table td {
      padding: 10px 8px;
      border-bottom: 1px solid var(--border-color);
      text-align: center;
      vertical-align: middle;
    }

    .invoice-table tbody tr {
      transition: background-color 0.2s ease;
    }

    .invoice-table tbody tr:hover {
      background-color: var(--bg-light);
    }

    .invoice-table input {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-size: 13px;
      text-align: center;
      transition: all 0.2s ease;
      background: var(--bg-white);
    }

    .invoice-table input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
    }

    .invoice-table input[type="number"] {
      -moz-appearance: textfield;
    }

    .invoice-table input::-webkit-outer-spin-button,
    .invoice-table input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }

    /* Column Widths */
    .col-id { width: 110px; max-width: 110px; }
    .col-product { width: 180px; max-width: 180px; }
    .col-brand { width: 130px; max-width: 130px; }
    .col-category { width: 130px; max-width: 130px; }
    .col-hsn { width: 100px; max-width: 100px; }
    .col-price { width: 100px; max-width: 100px; }
    .col-unit { width: 80px; max-width: 80px; }
    .col-discount { width: 90px; max-width: 90px; }
    .col-gst { width: 80px; max-width: 80px; }
    .col-amount { width: 120px; max-width: 120px; }
    .col-action { width: 60px; max-width: 60px; }

    /* Add Row Button */
    .add-row-wrapper {
      padding: 18px;
      text-align: center;
      background: var(--bg-light);
    }

    .btn-add-row {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 22px;
      background: var(--primary-color);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: var(--shadow-md);
    }

    .btn-add-row:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .btn-add-row .material-icons {
      font-size: 20px;
    }

    .btn-delete {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: #fee2e2;
      color: var(--danger-color);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-delete:hover {
      background: #fecaca;
      transform: scale(1.05);
    }

    .btn-delete .material-icons {
      font-size: 20px;
    }

    /* Total Section */
    .invoice-total-section {
      padding: 25px 35px;
      background: var(--bg-white);
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-md);
    }

    .total-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .payment-options {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .custom-checkbox {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      user-select: none;
    }

    .custom-checkbox input[type="checkbox"] {
      width: 20px;
      height: 20px;
      cursor: pointer;
      accent-color: var(--primary-color);
    }

    .custom-checkbox label {
      font-size: 14px;
      font-weight: 500;
      color: var(--text-primary);
      cursor: pointer;
    }

    .total-display {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .total-label {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .total-amount {
      padding: 12px 24px;
      background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 24px;
      font-weight: 700;
      min-width: 200px;
      text-align: right;
      box-shadow: var(--shadow-md);
    }

    /* Submit Section */
    .submit-section {
      padding: 25px 35px;
      background: var(--bg-white);
      border-radius: 12px;
      text-align: center;
      box-shadow: var(--shadow-md);
    }

    .btn-submit {
      padding: 14px 42px;
      background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: var(--shadow-lg);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 30px -5px rgba(16, 185, 129, 0.4);
    }

    /* Responsive Design */
    @media (max-width: 1200px) {
      .form-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .invoice-container {
        margin: 0;
        border-radius: 0;
        padding: 15px !important;
      }

      .top-bar-wrapper {
        padding: 15px 20px !important;
      }

      .invoice-header-section,
      .customer-info-section,
      .invoice-items-section,
      .invoice-total-section,
      .submit-section {
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 15px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .invoice-title {
        font-size: 20px;
      }

      .invoice-subtitle {
        font-size: 12px;
      }

      .total-wrapper {
        flex-direction: column;
        align-items: stretch;
      }

      .total-display {
        flex-direction: column;
        align-items: stretch;
      }

      .total-amount {
        text-align: center;
      }
    }

    /* Loading State */
    .form-input.loading {
      background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
      background-size: 200% 100%;
      animation: loading 1.5s infinite;
    }

    @keyframes loading {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Alert Messages */
    .alert-message {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 20px;
      display: none;
      font-size: 14px;
      font-weight: 500;
    }

    .alert-success {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #10b981;
    }

    .alert-error {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #ef4444;
    }

    /* Breadcrumb Enhancements */
    .breadcrumb-item + .breadcrumb-item::before {
      content: "›";
      color: #9ca3af;
      font-size: 18px;
      font-weight: 600;
      padding: 0 8px;
    }

    .breadcrumb a:hover {
      color: #764ba2 !important;
      transform: translateX(2px);
    }

    @media (max-width: 768px) {
      .top-bar-wrapper {
        flex-direction: column;
        align-items: stretch !important;
      }
      
      .breadcrumb {
        justify-content: center;
      }
    }

    /* Ensure page content doesn't overlap sidebar */
    #content.page-content {
      margin-left: 280px;
      width: calc(100% - 280px);
      position: relative;
      z-index: 1;
    }

    @media (max-width: 768px) {
      #content.page-content {
        margin-left: 0;
        width: 100%;
      }
    }

    /* When sidebar is toggled closed on desktop */
    @media (min-width: 769px) {
      #content.page-content.active {
        margin-left: 0;
        width: 100%;
      }
    }
  </style>
  <!--Vertical Navbar-->
  <%- include('header') %>

    <!-- End vertical navbar -->

    <!-- Page content holder -->
    <div class="page-content" id="content" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 0; margin: 0;">
      <!-- Top Bar with Toggle button and Breadcrumb -->
      <div class="top-bar-wrapper" style="display: flex; align-items: center; justify-content: space-between; padding: 20px 30px; background: rgba(0, 0, 0, 0.1); backdrop-filter: blur(10px); margin-bottom: 0; flex-wrap: wrap; gap: 15px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
        <button id="sidebarCollapse" type="button" class="btn btn-light bg-white rounded-pill shadow-sm px-4">
          <i class="align justify icon"></i>
          <small class="text-uppercase font-weight-bold">Menu</small>
        </button>
        
        <nav aria-label="breadcrumb" style="margin: 0;">
          <ol class="breadcrumb" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); padding: 12px 24px; border-radius: 50px; margin: 0; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); border: 1px solid rgba(255, 255, 255, 0.3);">
            <li class="breadcrumb-item">
              <a href="/" style="color: #667eea; text-decoration: none; font-weight: 600; font-size: 14px; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 5px;">
                <span class="material-icons" style="font-size: 18px;">home</span>
                Home
              </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page" style="color: #764ba2; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 5px;">
              <span class="material-icons" style="font-size: 18px;">receipt_long</span>
              Invoice Generation
            </li>
          </ol>
        </nav>
      </div>

      <!-- Alert Message -->
      <div id="alertMessage" class="alert-message" style="margin: 20px 30px 0;"></div>

      <!-- form here -->
      <form action="/submitbill" method="POST" id="billForm">
        <div class="invoice-container" style="padding: 30px;">
          
          

          <!-- Customer Information Section -->
          <div class="customer-info-section">
            <div class="section-title">
              <span class="material-icons">person</span>
              Customer Information
            </div>
            
            <div class="form-grid">
              <div class="form-group">
                <label class="form-label" for="PhoneNumber">
                  <span class="material-icons" style="font-size: 14px; vertical-align: middle;">phone</span>
                  Phone Number *
                </label>
                <input type="tel" 
                       placeholder="Enter 10-digit phone number" 
                       name="PhoneNumber" 
                       required 
                       class="form-input PhoneNumber"
                       id="PhoneNumber" 
                       maxlength="10"
                       pattern="[0-9]{10}"
                       oninput="getCustomerInfo(this.value)">
              </div>

              <div class="form-group">
                <label class="form-label" for="CustomerName">
                  <span class="material-icons" style="font-size: 14px; vertical-align: middle;">badge</span>
                  Customer Name *
                </label>
                <input type="text" 
                       placeholder="Enter customer name" 
                       name="CustomerName" 
                       required 
                       class="form-input CustomerName"
                       id="CustomerName">
              </div>

              <div class="form-group">
                <label class="form-label" for="Email">
                  <span class="material-icons" style="font-size: 14px; vertical-align: middle;">email</span>
                  Email Address
                </label>
                <input type="email" 
                       placeholder="customer@example.com" 
                       name="Email" 
                       class="form-input Email" 
                       id="Email">
              </div>

              <div class="form-group">
                <label class="form-label" for="Address">
                  <span class="material-icons" style="font-size: 14px; vertical-align: middle;">location_on</span>
                  Address
                </label>
                <input type="text" 
                       placeholder="Enter full address" 
                       name="Address" 
                       class="form-input Address" 
                       id="Address">
              </div>

              <div class="form-group">
                <label class="form-label" for="Pincode">
                  <span class="material-icons" style="font-size: 14px; vertical-align: middle;">pin_drop</span>
                  Pincode
                </label>
                <input type="text" 
                       placeholder="Enter pincode" 
                       name="Pincode" 
                       class="form-input Pincode" 
                       id="Pincode"
                       maxlength="6"
                       pattern="[0-9]{6}">
              </div>

              <div class="form-group">
                <label class="form-label" for="CGST">
                  <span class="material-icons" style="font-size: 14px; vertical-align: middle;">account_balance</span>
                  GST Number
                </label>
                <input type="text" 
                       placeholder="Enter GST number" 
                       name="CGST" 
                       class="form-input CGST" 
                       id="CGST"
                       style="text-transform: uppercase;">
              </div>

              <div class="form-group">
                <label class="form-label" for="todayDate">
                  <span class="material-icons" style="font-size: 14px; vertical-align: middle;">calendar_today</span>
                  Invoice Date *
                </label>
                <input type="date" 
                       name="todayDate" 
                       required
                       class="form-input todayDate" 
                       id="todayDate">
              </div>
            </div>
          </div>

          <!-- Invoice Items Section -->
          <div class="invoice-items-section">
            <div class="section-title">
              <span class="material-icons">shopping_cart</span>
              Invoice Items
            </div>

            <div class="table-wrapper">
              <table class="invoice-table">
                <thead>
                  <tr>
                    <th class="col-id">Product ID</th>
                    <th class="col-product">Product Name</th>
                    <th class="col-brand">Brand</th>
                    <th class="col-category">Category</th>
                    <th class="col-hsn">HSN/HSB</th>
                    <th class="col-price">Price (₹)</th>
                    <th class="col-unit">Qty</th>
                    <th class="col-discount">Disc (₹)</th>
                    <th class="col-gst">GST %</th>
                    <th class="col-amount">Amount (₹)</th>
                    <th class="col-action">Action</th>
                  </tr>
                </thead>

                <tbody id="table-body">
                  <tr class="single-row">
                    <td class="col-id">
                      <input type="text" 
                             placeholder="Scan/Enter ID" 
                             required 
                             name="id1" 
                             id="id1"
                             oninput="getInput(this.id)"
                             autocomplete="off">
                    </td>
                    <td class="col-product">
                      <input type="text" 
                             placeholder="Product name" 
                             name="product1" 
                             id="product1"
                             autocomplete="off">
                    </td>
                    <td class="col-brand">
                      <input type="text" 
                             placeholder="Brand" 
                             name="brand1" 
                             id="brand1"
                             autocomplete="off">
                    </td>
                    <td class="col-category">
                      <input type="text" 
                             placeholder="Category" 
                             name="category1" 
                             id="category1"
                             autocomplete="off">
                    </td>
                    <td class="col-hsn">
                      <input type="text" 
                             placeholder="HSN/HSB" 
                             name="hsb1" 
                             id="hsb1"
                             autocomplete="off">
                    </td>
                    <td class="col-price">
                      <input type="number" 
                             inputmode="decimal" 
                             placeholder="0.00" 
                             name="price1"
                             id="price1" 
                             onkeyup="getUnitInput(this.id)" 
                             step="0.01"
                             min="0">
                    </td>
                    <td class="col-unit">
                      <input type="number" 
                             placeholder="1" 
                             name="unit1" 
                             id="unit1" 
                             onkeyup="getUnitInput(this.id)"
                             min="1"
                             value="1">
                    </td>
                    <td class="col-discount">
                      <input type="number" 
                             inputmode="decimal" 
                             placeholder="0.00" 
                             name="discount1"
                             id="discount1" 
                             onkeyup="getUnitInput(this.id)"
                             step="0.01"
                             min="0">
                    </td>
                    <td class="col-gst">
                      <input type="number" 
                             inputmode="decimal" 
                             placeholder="0" 
                             name="gst1" 
                             id="gst1"
                             onkeyup="getUnitInput(this.id)"
                             step="0.01"
                             min="0"
                             max="100">
                    </td>
                    <td class="col-amount">
                      <input type="number" 
                             inputmode="decimal" 
                             placeholder="0.00"
                             name="amount1" 
                             id="amount1"
                             readonly
                             style="background: #f9fafb; font-weight: 600;">
                    </td>
                    <td class="col-action">
                      <button type="button" class="btn-delete" action="delete" title="Delete row">
                        <span class="material-icons" action="delete">delete_outline</span>
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="add-row-wrapper">
              <button type="button" class="btn-add-row" id="add-row">
                <span class="material-icons">add_circle</span>
                Add New Item
              </button>
            </div>
          </div>

          <!-- Total Section -->
          <div class="invoice-total-section">
            <div class="total-wrapper">
              <div class="payment-options">
                <div class="custom-checkbox">
                  <input type="checkbox" 
                         value="yes" 
                         name="onlinePayment" 
                         id="onlinePayment">
                  <label for="onlinePayment">
                    <span class="material-icons" style="font-size: 18px; vertical-align: middle; margin-right: 4px;">credit_card</span>
                    Online Payment
                  </label>
                </div>
              </div>
              
              <div class="total-display">
                <span class="total-label">Total Amount:</span>
                <input type="text" 
                       name="total" 
                       id="total" 
                       class="total-amount"
                       value="₹ 0.00"
                       readonly>
              </div>
            </div>
          </div>

          <!-- Submit Section -->
          <div class="submit-section">
            <button type="submit" class="btn-submit">
              <span class="material-icons" style="font-size: 20px; vertical-align: middle; margin-right: 8px;">save</span>
              Generate Invoice
            </button>
          </div>

        </div>
      </form>
      </div>
      <!-- form ends here -->
      <!-- Semnatic-UI Scripts -->
<%- include('footer') %>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.2.13/semantic.min.js"></script>

      <!-- Option 1: Bootstrap Bundle with Popper -->
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-b5kHyXgcpbZJO/tY9Ul7kGkf1S0CWuKcCD38l8YkeH8z8QjE0GmW1gYU5S9FOnJ0"
        crossorigin="anonymous"></script>
      <script>
        $(function () {
          // Sidebar toggle behavior
          $('#sidebarCollapse').on('click', function () {
            $('#sidebar').toggleClass('active');
            $('#content').toggleClass('active');
            $('#sidebarOverlay').toggleClass('active');
          });

          // Close sidebar when clicking overlay (mobile)
          $('#sidebarOverlay').on('click', function() {
            $('#sidebar').removeClass('active');
            $('#content').removeClass('active');
            $(this).removeClass('active');
          });
        });

        // Set today's date as default
        document.getElementById("todayDate").valueAsDate = new Date();

        const tBody = document.getElementById("table-body");

        // Show alert message
        const showAlert = (message, type = 'error') => {
          const alertDiv = document.getElementById('alertMessage');
          alertDiv.textContent = message;
          alertDiv.className = `alert-message alert-${type}`;
          alertDiv.style.display = 'block';
          
          setTimeout(() => {
            alertDiv.style.display = 'none';
          }, 5000);
        };

        // Add new row function
        const addNewRow = () => {
          const rows = document.querySelectorAll("tr.single-row");
          const currentRowLength = rows.length + 1;
          const row = document.createElement("tr");
          row.className = "single-row";
          row.innerHTML = `
            <td class="col-id">
              <input type="text" placeholder="Scan/Enter ID" name="id${currentRowLength}" id="id${currentRowLength}" oninput="getInput(this.id)" autocomplete="off">
            </td>
            <td class="col-product">
              <input type="text" placeholder="Product name" name="product${currentRowLength}" id="product${currentRowLength}" autocomplete="off">
            </td>
            <td class="col-brand">
              <input type="text" placeholder="Brand" name="brand${currentRowLength}" id="brand${currentRowLength}" autocomplete="off">
            </td>
            <td class="col-category">
              <input type="text" placeholder="Category" name="category${currentRowLength}" id="category${currentRowLength}" autocomplete="off">
            </td>
            <td class="col-hsn">
              <input type="text" placeholder="HSN/HSB" name="hsb${currentRowLength}" id="hsb${currentRowLength}" autocomplete="off">
            </td>
            <td class="col-price">
              <input type="number" inputmode="decimal" placeholder="0.00" name="price${currentRowLength}" id="price${currentRowLength}" onkeyup="getUnitInput(this.id)" step="0.01" min="0">
            </td>
            <td class="col-unit">
              <input type="number" placeholder="1" name="unit${currentRowLength}" id="unit${currentRowLength}" onkeyup="getUnitInput(this.id)" min="1" value="1">
            </td>
            <td class="col-discount">
              <input type="number" inputmode="decimal" placeholder="0.00" name="discount${currentRowLength}" id="discount${currentRowLength}" onkeyup="getUnitInput(this.id)" step="0.01" min="0">
            </td>
            <td class="col-gst">
              <input type="number" inputmode="decimal" placeholder="0" name="gst${currentRowLength}" id="gst${currentRowLength}" onkeyup="getUnitInput(this.id)" step="0.01" min="0" max="100">
            </td>
            <td class="col-amount">
              <input type="number" inputmode="decimal" placeholder="0.00" name="amount${currentRowLength}" id="amount${currentRowLength}" readonly style="background: #f9fafb; font-weight: 600;">
            </td>
            <td class="col-action">
              <button type="button" class="btn-delete" action="delete" title="Delete row">
                <span class="material-icons" action="delete">delete_outline</span>
              </button>
            </td>
          `;

          tBody.appendChild(row);
          const idName = `id${currentRowLength}`;
          document.getElementById(idName).focus();
        };

        // Add row event listener
        document.getElementById("add-row").addEventListener("click", (e) => {
          e.preventDefault();
          addNewRow();
        });

        // Calculate unit price with discount and GST
        const getUnitInput = (selectId) => {
          const rows = document.querySelectorAll("tr.single-row");
          rows.forEach((currentRow, index) => {
            const rowIndex = index + 1;
            const selectedUnitId = currentRow.querySelector(`#unit${rowIndex}`)?.id;
            const selectedDiscountId = currentRow.querySelector(`#discount${rowIndex}`)?.id;
            const selectedGstId = currentRow.querySelector(`#gst${rowIndex}`)?.id;
            const selectedPriceId = currentRow.querySelector(`#price${rowIndex}`)?.id;
            
            if (selectedUnitId === selectId || selectedDiscountId === selectId || selectedGstId === selectId || selectedPriceId === selectId) {
              const unit = parseFloat(currentRow.querySelector(`#unit${rowIndex}`).value) || 0;
              const discount = parseFloat(currentRow.querySelector(`#discount${rowIndex}`).value) || 0;
              const gst = parseFloat(currentRow.querySelector(`#gst${rowIndex}`).value) || 0;
              const price = parseFloat(currentRow.querySelector(`#price${rowIndex}`).value) || 0;
              
              // Calculate: (price * unit - discount) + GST%
              let unitPrice = unit * price;
              unitPrice = unitPrice - discount;
              unitPrice = unitPrice + (unitPrice * gst / 100);
              
              const amount = unitPrice.toFixed(2);
              currentRow.querySelector(`#amount${rowIndex}`).value = amount;

              overallSum();
            }
          });
        };

        // Get product information by ID
        const getInput = (id) => {
          const rows = document.querySelectorAll("tr.single-row");
          rows.forEach((currentRow, index) => {
            const rowIndex = index + 1;
            const selectedId = currentRow.querySelector(`#id${rowIndex}`)?.id;
            
            if (selectedId === id) {
              const currentId = currentRow.querySelector(`#id${rowIndex}`).value;
              
              if (currentId != null && currentId.length >= 7) {
                // Add loading state
                currentRow.querySelector(`#id${rowIndex}`).classList.add('loading');
                
                $.ajax({
                  type: "POST",
                  url: "/fetchitem",
                  data: { "itemid": currentId },
                  success: function (data) {
                    currentRow.querySelector(`#id${rowIndex}`).classList.remove('loading');
                    
                    if (data.status === 200) {
                      const productData = data.rows;
                      if (productData.length > 0) {
                        const product = productData[0];
                        
                        currentRow.querySelector(`#product${rowIndex}`).value = product.ItemName || '';
                        currentRow.querySelector(`#brand${rowIndex}`).value = product.Brand || '';
                        currentRow.querySelector(`#category${rowIndex}`).value = product.Category || '';
                        currentRow.querySelector(`#price${rowIndex}`).value = product.Amount || '';
                        currentRow.querySelector(`#hsb${rowIndex}`).value = product.HSN || '';
                        currentRow.querySelector(`#unit${rowIndex}`).value = 1;

                        // Calculate amount
                        const price = parseFloat(product.Amount) || 0;
                        const unit = 1;
                        const amount = (unit * price).toFixed(2);
                        currentRow.querySelector(`#amount${rowIndex}`).value = amount;

                        overallSum();
                        addNewRow();
                        
                        showAlert('Product added successfully!', 'success');
                      }
                    } else {
                      showAlert('Item not found. Please check the product ID.');
                    }
                  },
                  error: function() {
                    currentRow.querySelector(`#id${rowIndex}`).classList.remove('loading');
                    showAlert('Error fetching product information. Please try again.');
                  }
                });
              }
            }
          });
        };

        // Get customer information by phone number
        const getCustomerInfo = (phoneNumber) => {
          if (phoneNumber.length === 10) {
            const phoneInput = document.querySelector("#PhoneNumber");
            phoneInput.classList.add('loading');
            
            $.ajax({
              type: "POST",
              url: "/fetchcustomer",
              data: { "PhoneNumber": phoneNumber },
              success: function (data) {
                phoneInput.classList.remove('loading');
                
                if (data.status === 200) {
                  const customerData = data.rows;
                  if (customerData.length > 0) {
                    const customer = customerData[0];
                    
                    if (customer.CustomerName) {
                      document.querySelector("#CustomerName").value = customer.CustomerName;
                    }
                    if (customer.Email) {
                      document.querySelector("#Email").value = customer.Email;
                    }
                    if (customer.Address) {
                      document.querySelector("#Address").value = customer.Address;
                    }
                    if (customer.Pincode) {
                      document.querySelector("#Pincode").value = customer.Pincode;
                    }
                    if (customer.CGST) {
                      document.querySelector("#CGST").value = customer.CGST;
                    }
                    
                    showAlert('Customer information loaded successfully!', 'success');
                  }
                } else {
                  // Clear fields for new customer
                  document.querySelector("#CustomerName").value = '';
                  document.querySelector("#Email").value = '';
                  document.querySelector("#Address").value = '';
                  document.querySelector("#Pincode").value = '';
                  document.querySelector("#CGST").value = '';
                }
              },
              error: function() {
                phoneInput.classList.remove('loading');
                showAlert('Error fetching customer information.');
              }
            });
          }
        };

        // Calculate overall sum/total
        const overallSum = () => {
          const rows = document.querySelectorAll("tr.single-row");
          let selectedAmount = 0;
          
          rows.forEach((currentRow, index) => {
            const rowIndex = index + 1;
            const amount = parseFloat(currentRow.querySelector(`#amount${rowIndex}`)?.value) || 0;
            selectedAmount += amount;
          });
          
          document.getElementById("total").value = `₹ ${selectedAmount.toFixed(2)}`;
        };

        // Delete row from the table
        tBody.addEventListener("click", (e) => {
          const el = e.target;
          const deleteAction = e.target.getAttribute("action");
          
          if (deleteAction === "delete") {
            const rows = document.querySelectorAll("tr.single-row");
            if (rows.length > 1) {
              delRow(el);
              overallSum();
              showAlert('Item removed from invoice.', 'success');
            } else {
              showAlert('Cannot delete the last row. At least one item is required.');
            }
          }
        });

        // Target row and remove from DOM
        const delRow = (el) => {
          el.closest('tr.single-row').remove();
        };

        // Form validation before submit
        document.getElementById('billForm').addEventListener('submit', function(e) {
          const rows = document.querySelectorAll("tr.single-row");
          let hasValidItem = false;
          
          rows.forEach((row, index) => {
            const id = row.querySelector(`#id${index + 1}`).value;
            const product = row.querySelector(`#product${index + 1}`).value;
            const price = row.querySelector(`#price${index + 1}`).value;
            
            if (id && product && price) {
              hasValidItem = true;
            }
          });
          
          if (!hasValidItem) {
            e.preventDefault();
            showAlert('Please add at least one valid item to the invoice.');
            return false;
          }
        });

        // Initialize total display
        overallSum();
      </script>
</body>

</html>